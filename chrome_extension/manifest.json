{
  "manifest_version": 3,
  "name": "GSXT 企业信用存档助手",
  "version": "1.7.7",
  "description": "在当前 Chrome 登录会话中批量查询国家企业信用信息并保存全页截图。",
  "permissions": ["activeTab", "cookies", "declarativeNetRequest", "downloads", "management", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://*.gsxt.gov.cn/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "gsxt_headers", "enabled": true, "path": "rules.json" }]
  },
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bootstrap.js" },
  "action": {
    "default_title": "打开 GSXT 并执行保存的任务",
    "default_popup": "popup.html"
  },
  "side_panel": { "default_path": "popup.html" }
}
